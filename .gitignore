# Tikinet C++ - .gitignore

# Archivos compilados y ejecutables
*.exe
*.o
*.obj
*.out
*.dll
*.dylib
*.so
*.a
*.bin
*.app

# Archivos generados por el programa (Reportes)
# Ignoramos todos los .txt para evitar subir reportes de escaneos o contraseñas
*.txt
*.log
*.json
*.csv

# Archivos de depuración
debug_output.txt
*.tmp
*.temp

# Archivos de Windows
Thumbs.db
desktop.ini
*.cab
*.msi
*.msm

# Archivos de IDE y editores
.vscode/
.idea/
*.user
*.suo
*.sln
*.vcxproj
*.vcxproj.filters
*.dev
*.layout
*.depend
*.cbp
*.workspace
*.kdev4
*.code-workspace
*.swp
*.swo
*~

# Directorios de compilación
build/
bin/
Debug/
Release/
obj/
*.dSYM/
__pycache__/

# Archivos de backup
*.bak
*.backup
*.old
*.orig